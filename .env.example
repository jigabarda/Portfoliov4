# Resend API key (https://resend.com/api-keys). Without CONTACT_FROM_EMAIL the form uses the
# onboarding@resend.dev test sender, which only delivers to the Resend account owner.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@jamesgabarda.com
# Optional. Only after the domain is verified in Resend, e.g. "James Gabarda <hello@jamesgabarda.com>".
CONTACT_FROM_EMAIL=
